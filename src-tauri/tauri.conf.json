{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tangent-note",
  "version": "0.1.0",
  "identifier": "to.tangent.note",
  "build": {
    "beforeBuildCommand": "npm run desktop:sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/note-serve"
    ]
  }
}
